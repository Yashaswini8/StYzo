# ---- Server ----
PORT=3000

# ---- Meta WhatsApp Cloud API (https://developers.facebook.com) ----
# Numeric ID of the WhatsApp number to send messages FROM (Graph node id).
META_PHONE_NUMBER_ID=your_phone_number_id
# Access token (temporary tokens from the Getting Started page expire ~24h).
META_ACCESS_TOKEN=your_meta_access_token
# Your own webhook verify token — set a private value and enter the SAME value
# in Meta's webhook subscription settings. Never share or reuse one from examples.
VERIFY_TOKEN=choose-your-own-verify-token

# ---- Google Gemini (https://aistudio.google.com/apikey) ----
# Free API key used for AI listing generation (model below has a free tier).
GEMINI_API_KEY=your-gemini-api-key
# Model used for listing generation. NOTE: gemini-2.5-flash was retired for
# new accounts (HTTP 404) — gemini-3.6-flash is the current stable free model.
GEMINI_MODEL=gemini-3.6-flash

# ---- Pricing rules (rule-based, not AI) ----
# Base nightly rate used by the pricing estimator.
BASE_PRICE=100
# Extra added per night on Friday and Saturday weekend nights.
WEEKEND_SURCHARGE=25
# Currency symbol used when formatting quotes.
PRICING_CURRENCY=USD

# Default city/folder used when a pricing request mentions dates
# but no recognised city name (demo fallback).
DEFAULT_CITY=Barcelona